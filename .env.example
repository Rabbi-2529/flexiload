DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Dhaka

# SQLite Database
DB_ENGINE=sqlite

# SQLite database file
DB_NAME=flexiload

MODEM_SMS_POLL_INTERVAL=20
# Leave these empty for SQLite
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Generate with: python manage.py generate_pin_key
PIN_ENCRYPTION_KEY=

# Use mock until a supported modem is connected.
MODEM_BACKEND=mock
MODEM_PORT=COM3
MODEM_BAUDRATE=115200
MODEM_TIMEOUT=30

LOG_LEVEL=INFO
IGL_WEBHOOK_URL=
IGL_WEBHOOK_SECRET=
IGL_WEBHOOK_TIMEOUT=10

# Offer-check aggregator API
OFFER_API_BASE_URL=
OFFER_API_USER_ID=
OFFER_API_PASSWORD=
OFFER_API_REFER_ID=
OFFER_API_TIMEOUT=30
